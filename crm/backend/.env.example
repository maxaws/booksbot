# Copier ce fichier en .env et adapter les valeurs

# Environnement : "development" active Swagger UI et désactive HSTS
ENV=production

# URL de la base de données SQLite (chemin absolu recommandé en production)
DATABASE_URL=sqlite:////var/lib/crm/crm.db

# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS

# Durée de validité des tokens JWT en minutes (défaut : 480 = 8h)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origines autorisées pour CORS (séparer par virgule si plusieurs)
# ALLOWED_ORIGINS=["https://crm.onesystem.fr"]

# Identifiant de connexion admin
ADMIN_USERNAME=admin

# Hash bcrypt du mot de passe admin
# Générer avec : python crm/backend/hash_password.py MonMotDePasse
ADMIN_PASSWORD_HASH=
